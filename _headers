# Headers de Cloudflare. Generado desde vercel.json por el mismo motivo
# que _redirects: ese archivo no se lee en producción, así que el noindex
# de la lista de revendedores y el caché de assets no se estaban aplicando.

# Folleto con precios de todas las marcas. Igual criterio que la lista de
# revendedores: no se lista en robots.txt porque robots.txt es público y
# publicaría el slug que se busca ocultar. Se bloquea con noindex (meta + este
# header), que sí requiere que el crawler pueda leer la página.
/folleto-8f3a1c9d/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

# Plantillas crudas de producto.html?id=X y categoria.html?c=X: el contenido
# real y canónico vive en /producto/<slug>/ y /categoria/<slug>/, generados a
# partir de estas mismas plantillas. Nada linkea a la forma cruda, pero si un
# crawler la encuentra igual, no debe competir como duplicado.
/producto.html
  X-Robots-Tag: noindex, follow

/categoria.html
  X-Robots-Tag: noindex, follow

# La vuelta de Mercado Pago lleva el id de pago en la query: no tiene por qué
# entrar al índice ni quedar cacheada en un proxy compartido.
/tienda/gracias/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

# Ojo con esta: robots.txt ya tiene "Disallow: /lista-revendedores-5d2f2e5e/",
# así que Google no rastrea la página y por lo tanto nunca va a leer este
# header. Se deja igual como red de seguridad para el día que se saque el
# Disallow. Si lo que se busca es sacarla del índice de verdad (y no sólo
# evitar el rastreo), hay que hacer lo contrario: permitir el rastreo en
# robots.txt para que Google pueda ver este noindex.
/lista-revendedores-5d2f2e5e/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/cotizacion/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Ojo: "immutable" es una promesa de que el archivo en esta URL no cambia
# nunca, y sólo vale cuando el nombre lleva un hash del contenido. Acá los
# assets se editan en el lugar (se reemplaza una foto, se regenera una ficha,
# se toca site.js), así que estaba dejando copias viejas pegadas un año en el
# navegador de quien ya las había abierto. Un día fresco + una semana de
# stale-while-revalidate: el visitante recibe la copia cacheada al instante y
# el navegador la refresca de fondo, así el cambio entra solo al día siguiente.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# JS y CSS: el HTML de las páginas se actualiza con cada deploy y el JS tiene que ser de la misma
# versión (un site.js viejo en el teléfono rompía la hidratación de la ficha: foto deformada y sin botones).
/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=300, must-revalidate

/uploads/*
  Cache-Control: public, max-age=31536000, immutable

# El origen en vercel.json era la regex "/(.*)\.html". Cloudflare no acepta
# regex acá, sólo comodines, así que queda como /*.html. Ojo: el sitio sirve
# las páginas con URL de directorio ("/blog/foo/"), no con ".html" a la vista,
# así que esta regla probablemente tampoco hacía nada en Vercel. Se traduce
# tal cual para no cambiar la intención original, pero conviene revisarla.
/*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/guia.html
  X-Robots-Tag: noindex, follow
